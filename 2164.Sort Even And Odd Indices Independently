class Solution(object):
    def sortEvenOdd(self, nums):
        Even =[]
        odd =[]

        for i in range (len(nums)):
            if i % 2 ==0:
                Even.append(nums[i])
            else:
                odd.append(nums[i])        
        Even.sort()
        odd.sort(reverse=True)

        e = 0
        o = 0

        for i in range(len(nums)):
            if i % 2 ==0:
                nums[i] = Even[e]
                e +=1
            else:
                nums[i] = odd[o]
                o +=1
        return nums       
